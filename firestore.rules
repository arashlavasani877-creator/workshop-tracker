rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function isAccounting() {
      return isSignedIn() && myRole() == 'accounting';
    }
    function canManageMaterialPurchases() {
      return isAdmin() || isAccounting();
    }
    // isEditor: کسانی که اجازه‌ی نوشتن/تغییر روی قراردادها دارند (مدیر + سرپرست نصب + سرپرست افراچوب)
    function isEditor() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'supervisor' || myRole() == 'afrachoobSupervisor');
    }
    // isApproved: کسانی که فقط اجازه‌ی خواندن دارند هم شامل می‌شود (+ مدیر پروژه و معاونت PMO، هر دو فقط‌گزارش)
    function isApproved() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'supervisor' || myRole() == 'viewer' || myRole() == 'afrachoobSupervisor' || myRole() == 'pmoDeputy' || myRole() == 'accounting');
    }
    // isCommentOnlyUpdate: مدیر پروژه و معاونت PMO اجازه ندارند هیچ فیلدی از قرارداد را تغییر دهند جز کامنت‌ها —
    // این تابع فقط زمانی true است که در آپدیت، فقط و فقط فیلد comments تغییر کرده باشد (نه فیلد دیگری)
    function isCommentOnlyUpdate() {
      return isSignedIn() && (myRole() == 'viewer' || myRole() == 'pmoDeputy')
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role in ['pending', 'admin']
                    && (request.resource.data.role != 'admin'
                        || (
                             request.auth.token.email == 'arashlavasani891@gmail.com'
                             && request.resource.data.email == request.auth.token.email
                           ));
      allow update: if isAdmin() || (
                      isSignedIn() && request.auth.uid == userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
                    );
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      // خواندن: مدیر، سرپرست، و مدیر پروژه (نقش فقط‌گزارش)
      allow read: if isApproved();
      // نوشتن/ساخت/حذف: فقط مدیر و سرپرست — مدیر پروژه هرگز نمی‌تواند چیزی تغییر دهد
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isCommentOnlyUpdate() || (
                       isEditor() && (
                         isAdmin() ||
                         (
                           request.resource.data.get('dueDate', null) == resource.data.get('dueDate', null) &&
                           request.resource.data.get('itemCode', null) == resource.data.get('itemCode', null) &&
                           request.resource.data.get('contractDate', null) == resource.data.get('contractDate', null)
                         )
                       )
                     );
    }

    // activityLog: لاگ فعالیت‌ها — فقط مدیر می‌تواند بخواند، هرکس فقط برای خودش می‌تواند ثبت کند،
    // و هیچ‌کس (حتی مدیر) نمی‌تواند لاگ ثبت‌شده را تغییر یا حذف کند (برای اعتبار گزارش).
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isEditor() && request.resource.data.byUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // پیام عمومی مدیر پروژه / معاونت PMO با مدیر کنترل پروژه.
    // کاربران گزارش‌خوان فقط پیام‌های ارسالی یا دریافتی حساب خودشان را می‌بینند؛ معاونت PMO هیچ دسترسی به خرید متریال نمی‌گیرد.
    match /pmNotes/{noteId} {
      allow read: if isAdmin() || (
                    isSignedIn()
                    && (myRole() == 'viewer' || myRole() == 'pmoDeputy')
                    && (resource.data.get('byUid', '') == request.auth.uid || resource.data.get('toUid', '') == request.auth.uid)
                  );

      allow create: if isAdmin() || (
                      isSignedIn()
                      && (myRole() == 'viewer' || myRole() == 'pmoDeputy')
                      && request.resource.data.keys().hasOnly([
                        'text', 'by', 'byRole', 'byUid', 'time', 'seen'
                      ])
                      && request.resource.data.byUid == request.auth.uid
                      && request.resource.data.byRole == myRole()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.time is int
                      && request.resource.data.seen == false
                    );

      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
                    && request.resource.data.seen == true
                    && (
                      isAdmin()
                      || (
                        (myRole() == 'viewer' || myRole() == 'pmoDeputy')
                        && resource.data.get('toUid', '') == request.auth.uid
                      )
                    );

      allow delete: if isAdmin() || (
                      isSignedIn()
                      && resource.data.get('byUid', '') == request.auth.uid
                    );
    }

    // خرید متریال ماهانه: مدیر امکان کامل دارد؛ مدیر پروژه فقط برای کارت‌های گزارش مالی اجازه‌ی خواندن دارد.
    match /materialPurchases/{purchaseId} {
      allow read: if canManageMaterialPurchases() || (isSignedIn() && myRole() == 'viewer');

      allow create: if canManageMaterialPurchases()
                    && request.resource.data.keys().hasOnly([
                      'supplierName', 'amount', 'year', 'month', 'note',
                      'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
                    ])
                    && request.resource.data.supplierName is string
                    && request.resource.data.supplierName.size() > 0
                    && (request.resource.data.amount is int || request.resource.data.amount is float)
                    && request.resource.data.amount >= 0
                    && request.resource.data.year is int
                    && request.resource.data.year >= 1300
                    && request.resource.data.year <= 1600
                    && request.resource.data.month is int
                    && request.resource.data.month >= 1
                    && request.resource.data.month <= 12
                    && request.resource.data.note is string
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.createdAt is int
                    && request.resource.data.updatedAt is int;

      allow update: if canManageMaterialPurchases()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'supplierName', 'amount', 'year', 'month', 'note',
                      'updatedBy', 'updatedAt'
                    ])
                    && request.resource.data.supplierName is string
                    && request.resource.data.supplierName.size() > 0
                    && (request.resource.data.amount is int || request.resource.data.amount is float)
                    && request.resource.data.amount >= 0
                    && request.resource.data.year is int
                    && request.resource.data.year >= 1300
                    && request.resource.data.year <= 1600
                    && request.resource.data.month is int
                    && request.resource.data.month >= 1
                    && request.resource.data.month <= 12
                    && request.resource.data.note is string
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt is int;

      allow delete: if canManageMaterialPurchases();
    }

    // تنظیمات شخصی رابط کاربری: Admin و مدیر پروژه فقط تنظیمات حساب خودشان را می‌خوانند/می‌نویسند.
    // این سند صرفاً چیدمان کارت‌های گزارش مالی را نگه می‌دارد و به داده‌های قرارداد/خرید دست نمی‌زند.
    match /userSettings/{userId} {
      allow read: if isSignedIn()
                  && request.auth.uid == userId
                  && (myRole() == 'admin' || myRole() == 'viewer');

      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && (myRole() == 'admin' || myRole() == 'viewer')
                            && request.resource.data.keys().hasOnly([
                              'financialCardLayout', 'updatedAt'
                            ])
                            && request.resource.data.financialCardLayout is list
                            && request.resource.data.financialCardLayout.size() <= 50
                            && request.resource.data.updatedAt is int;

      allow delete: if false;
    }
  }
}
