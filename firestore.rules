rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    // isEditor: کسانی که اجازه‌ی نوشتن/تغییر روی قراردادها دارند (مدیر + سرپرست نصب)
    function isEditor() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'supervisor');
    }
    // isApproved: کسانی که فقط اجازه‌ی خواندن دارند هم شامل می‌شود (+ مدیر پروژه، نقش فقط‌گزارش)
    function isApproved() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'supervisor' || myRole() == 'viewer');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role in ['pending', 'admin']
                    && (request.resource.data.role != 'admin'
                        || request.resource.data.email == 'arashlavasani891@gmail.com');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      // خواندن: مدیر، سرپرست، و مدیر پروژه (نقش فقط‌گزارش)
      allow read: if isApproved();
      // نوشتن/ساخت/حذف: فقط مدیر و سرپرست — مدیر پروژه هرگز نمی‌تواند چیزی تغییر دهد
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isEditor() && (
                       isAdmin() ||
                       (
                         request.resource.data.get('dueDate', null) == resource.data.get('dueDate', null) &&
                         request.resource.data.get('itemCode', null) == resource.data.get('itemCode', null) &&
                         request.resource.data.get('contractDate', null) == resource.data.get('contractDate', null)
                       )
                     );
    }

    // activityLog: لاگ فعالیت‌ها — فقط مدیر می‌تواند بخواند، هرکس فقط برای خودش می‌تواند ثبت کند،
    // و هیچ‌کس (حتی مدیر) نمی‌تواند لاگ ثبت‌شده را تغییر یا حذف کند (برای اعتبار گزارش).
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isEditor() && request.resource.data.byUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
  }
}
